# Required in production: the passcode you sign in with.
OWNER_PASSCODE=
# Signs your session cookie. Any long random string.
SESSION_SECRET=

# Your AI team (Claude). Without it, agents show "blocked" instead of faking work.
ANTHROPIC_API_KEY=

# Database. Without these, data is stored in DATA_DIR/sean-os.json (fine for Railway with a volume, NOT for Vercel).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=sean-os
DATA_DIR=

# Images: mockups, campaign visuals, brand boards (fal.ai, Nano Banana by default).
FAL_KEY=
FAL_IMAGE_MODEL=fal-ai/nano-banana

# Push notifications. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Serverless scheduling (Vercel Cron sends this automatically as a Bearer token).
CRON_SECRET=
